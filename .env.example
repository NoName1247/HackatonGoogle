# ==============================================================================
# HORIZON RELAY — КОНФИГУРАЦИЯ ОКРУЖЕНИЯ (Production & Demo FinOps <= $50/mo)
# ==============================================================================

# --- Основные настройки приложения ---
APP_ENV=production
SECRET_KEY=horizon-relay-super-secret-jwt-key-2026-univ-audit
NEXT_PUBLIC_API_URL=http://localhost/api/v1

# --- PostgreSQL 16 (прямой пул SQLAlchemy AsyncAdaptedQueuePool без PgBouncer) ---
POSTGRES_USER=horizon
POSTGRES_PASSWORD=horizon_secure_pwd
POSTGRES_DB=horizon_relay
DATABASE_URL=postgresql+asyncpg://horizon:horizon_secure_pwd@postgres:5432/horizon_relay

# --- Единый контейнер Redis 7.2 (volatile-lfu) ---
# db=0: Очереди Celery, состояние Chord, Redis Streams (SSE), локи, Rate-Limit (БЕЗ TTL -> никогда не вытесняются!)
# db=1: L2 Кэш синергии, кэш проверки репо и LLM Feasibility Gate (ВСЕГДА С TTL -> управляются volatile-lfu)
REDIS_STATE_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1

# --- Векторная БД Qdrant v1.12+ (3 коллекции в FP32 RAM) ---
QDRANT_HOST=qdrant
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# --- Локальное CAS-хранилище PDF и сжатых zstd Markdown-слепков ---
BLOB_STORAGE_DIR=/var/lib/horizon/blobs

# --- Ключи облачных LLM API (LiteLLM Two-Tier Cascade) ---
# Если ключи не заданы, система автоматически переключается на встроенный детерминированный экстрактор
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Пул токенов GitHub API (Round-Robin ротация в Redis, через запятую) ---
GITHUB_PAT_POOL=

# --- Белый список доменов для автоматической проверки в Artifact Probe ---
AUTO_ALLOWLIST_DOMAINS=github.com,gitlab.com,huggingface.co,zenodo.org,kaggle.com,osf.io,figshare.com,data.mendeley.com

# --- FinOps и ресурсные предохранители ---
DAILY_LLM_BUDGET_USD=1.50
MAX_PAGES_PROCESSED=150
MAX_MAP_CHUNKS_PER_THESIS=10
MAX_TOTAL_TOKENS_PER_JOB=55000
ONNX_MAX_CONCURRENT=2

